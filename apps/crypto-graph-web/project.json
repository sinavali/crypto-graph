{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "crypto-graph-web",
  "projectType": "application",
  "sourceRoot": "apps/crypto-graph-web/src",
  "tags": [
    "profile:b",
    "scope:frontend",
    "lang:typescript"
  ],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm eslint . --max-warnings 0 && pnpm tsc --noEmit",
        "cwd": "apps/crypto-graph-web"
      },
      "inputs": [
        "default"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm vitest run --coverage",
        "cwd": "apps/crypto-graph-web"
      },
      "inputs": [
        "default",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/coverage"
      ]
    },
    "a11y": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm playwright test tests/a11y",
        "cwd": "apps/crypto-graph-web"
      },
      "inputs": [
        "default",
        "^production"
      ]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm next build",
        "cwd": "apps/crypto-graph-web"
      },
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/.next"
      ]
    },
    "audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm audit --audit-level high",
        "cwd": "apps/crypto-graph-web"
      },
      "inputs": [
        "default"
      ]
    }
  }
}