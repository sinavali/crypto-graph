{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "crypto-graph-web",
  "projectType": "application",
  "sourceRoot": "apps/crypto-graph-web/src",
  "tags": [
    "profile:b",
    "scope:frontend",
    "lang:python"
  ],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 -m py_compile src/app.py",
        "cwd": "apps/crypto-graph-web"
      },
      "inputs": ["default"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "PYTHONPATH=/home/sinavali/Workspace/Work/Projects/crypto-graph:. pytest -v tests/ --cov=src --cov-report=term-missing",
        "cwd": "apps/crypto-graph-web"
      },
      "inputs": ["default", "^production"],
      "outputs": ["{projectRoot}/.coverage"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 -m py_compile src/app.py",
        "cwd": "apps/crypto-graph-web"
      },
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uvicorn src.app:app --host 0.0.0.0 --port 8000",
        "cwd": "apps/crypto-graph-web"
      }
    },
    "audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 -c 'print(\"crypto-graph-web audit passed\")'",
        "cwd": "apps/crypto-graph-web"
      },
      "inputs": ["default"]
    }
  }
}
