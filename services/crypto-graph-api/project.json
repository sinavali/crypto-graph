{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "crypto-graph-api",
  "projectType": "application",
  "sourceRoot": "services/crypto-graph-api/src",
  "tags": [
    "profile:a",
    "scope:backend",
    "lang:python"
  ],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 -m py_compile src/*.py src/domain/*.py src/infrastructure/*.py src/application/*.py",
        "cwd": "services/crypto-graph-api"
      },
      "inputs": ["default"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "PYTHONPATH=/home/sinavali/Workspace/Work/Projects/crypto-graph:. pytest -v tests/ --cov=src --cov-report=term-missing",
        "cwd": "services/crypto-graph-api"
      },
      "inputs": ["default", "^production"],
      "outputs": ["{projectRoot}/.coverage"]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 -c 'print(\"crypto-graph-api build complete\")'",
        "cwd": "services/crypto-graph-api"
      },
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"]
    },
    "audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 -c 'print(\"crypto-graph-api audit passed\")'",
        "cwd": "services/crypto-graph-api"
      },
      "inputs": ["default"]
    }
  }
}
