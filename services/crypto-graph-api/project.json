{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "crypto-graph-api",
  "projectType": "application",
  "sourceRoot": "services/crypto-graph-api/src",
  "tags": [
    "profile:a",
    "scope:backend",
    "lang:python"
  ],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ruff check . && mypy src",
        "cwd": "services/crypto-graph-api"
      },
      "inputs": [
        "default"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pytest -v --cov=src --cov-report=term-missing",
        "cwd": "services/crypto-graph-api"
      },
      "inputs": [
        "default",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/.coverage"
      ]
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python -m build",
        "cwd": "services/crypto-graph-api"
      },
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "audit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pip-audit",
        "cwd": "services/crypto-graph-api"
      },
      "inputs": [
        "default"
      ]
    }
  }
}